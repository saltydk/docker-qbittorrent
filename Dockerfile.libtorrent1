ARG BASE_IMAGE="saltydk/alpine-s6overlay:sha-c9b0e93ddcce83f20d2ff5504541a46e6ca3f90f@sha256:a09aeb777d4a5038e2fb8c1c0d6e115565c646bfff5a51cfcc735761801ecc3e"

FROM ${BASE_IMAGE}

ARG QBITTORRENT_REPOSITORY="userdocs/qbittorrent-nox-static"
ARG QBITTORRENT_RELEASE="release-5.2.4_v1.2.20"
ARG QBITTORRENT_REVISION="2"
ARG QBITTORRENT_SHA256_AMD64="8b50214bbde610cce3f4e8fde55343997d97b19c4228dba3107d5ec2e75449ea"
ARG QBITTORRENT_SHA256_ARM64="ae48eb94471424be3298d041cb728b2bc3d95910da6fbb7b546c201d27bf6944"
ARG TARGETARCH

LABEL maintainer="salty"

ENV \
  HOME="/config" \
  XDG_CONFIG_HOME="/config" \
  XDG_DATA_HOME="/config" \
  # 3 minutes for services to exit
  S6_SERVICES_GRACETIME=180000 \
  S6_KILL_GRACETIME=3000

# Install the complete package set selected by the updater.
COPY packages/runtime/ /tmp/apk-locks/
RUN apk_arch="$(apk --print-arch)" \
  && /usr/local/libexec/apk-lock install "/tmp/apk-locks/${apk_arch}.lock" inherited \
  && mkdir -p /usr/share/image-inputs \
  && cp "/tmp/apk-locks/${apk_arch}.lock" /usr/share/image-inputs/runtime.lock \
  && rm -rf /tmp/apk-locks

RUN \
  case "${TARGETARCH}" in \
    "amd64") QBITTORRENT_ARCH="x86_64"; QBITTORRENT_SHA256="${QBITTORRENT_SHA256_AMD64}" ;; \
    "arm64") QBITTORRENT_ARCH="aarch64"; QBITTORRENT_SHA256="${QBITTORRENT_SHA256_ARM64}" ;; \
    *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
  esac \
  && echo "**** install qbittorrent-nox ****" \
  && curl -sSfL -o /usr/bin/qbittorrent-nox \
    "https://github.com/${QBITTORRENT_REPOSITORY}/releases/download/${QBITTORRENT_RELEASE}/${QBITTORRENT_ARCH}-qbittorrent-nox" \
  && echo "${QBITTORRENT_SHA256}  /usr/bin/qbittorrent-nox" | sha256sum -c - \
  && chmod 755 /usr/bin/qbittorrent-nox \
  && echo "**** cleanup ****" \
  && rm -rf \
    /root/.cache \
    /tmp/*

# Add root files
COPY ["root/", "/"]

ARG BASE_IMAGE
ARG APK_LOCKS_SHA256
ARG IMAGE_INPUTS_SHA256
LABEL io.saltydk.apk-locks.sha256="${APK_LOCKS_SHA256}" \
      io.saltydk.image-inputs.sha256="${IMAGE_INPUTS_SHA256}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      io.saltydk.qbittorrent.release="${QBITTORRENT_RELEASE}" \
      io.saltydk.qbittorrent.revision="${QBITTORRENT_REVISION}" \
      io.saltydk.qbittorrent.sha256.amd64="${QBITTORRENT_SHA256_AMD64}" \
      io.saltydk.qbittorrent.sha256.arm64="${QBITTORRENT_SHA256_ARM64}"

VOLUME ["/config", "/downloads"]
EXPOSE 8080/tcp
